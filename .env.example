# 复制为 .env（此文件已被 .gitignore 忽略，不会上传 GitHub），填入真实值。
# 真实密钥只应存在于本地的 .env 或环境变量中，禁止提交到仓库。

MINAGENT_API_KEY=your-api-key-here
MINAGENT_BASE_URL=https://note3-prev-api.askdiandian.com/v1
MINAGENT_MODEL=dots3-note-prev

# 认证方式：该接口使用 api-key 请求头（无 Bearer 前缀）
MINAGENT_AUTH_HEADER=api-key
MINAGENT_AUTH_PREFIX=

# 可选配置（以下均有默认值）
# MINAGENT_MAX_TOKENS=0
# MINAGENT_MAX_STEPS=10
# MINAGENT_MAX_CONTEXT_MESSAGES=20
# MINAGENT_KEEP_RECENT_MESSAGES=6
# MINAGENT_TIMEOUT=60