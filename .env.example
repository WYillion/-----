# 复制为 .env 或在 shell 中 export 以下环境变量
# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选配置（以下均有默认值）
MINAGENT_BASE_URL=https://api.deepseek.com
# deepseek-chat：通用对话，支持 function calling
# deepseek-reasoner：推理模型，会返回 reasoning_content 思考过程
MINAGENT_MODEL=deepseek-chat
MINAGENT_MAX_STEPS=10
MINAGENT_MAX_CONTEXT_MESSAGES=20
MINAGENT_KEEP_RECENT_MESSAGES=6
MINAGENT_TIMEOUT=60